# Runtime mode. Use "production" only when AUTH_SECRET is set securely.
ENVIRONMENT=development

# Replace with a long, random value. Never reuse the placeholder.
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL runtime connection. Use a pooled URL here when the provider supplies one.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DATABASE?sslmode=disable

# Optional direct PostgreSQL connection used by Prisma Migrate.
DIRECT_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:POSTGRES_PORT/POSTGRES_DATABASE?sslmode=disable

# Transactional email provider for verification and password recovery.
# Keep real API keys in local .env or Cloudflare Worker secrets only.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Республикалық математиктер бірлестігі <no-reply@matclub.kz>
APP_BASE_URL=https://matclub.kz
