{
  "name": "phase-one-membership-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "prisma generate && vinext dev",
    "build": "prisma generate && vinext build",
    "start": "prisma generate && vinext start",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint app db lib worker tests scripts prisma.config.ts eslint.config.mjs vite.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "bootstrap:production-admin": "tsx scripts/bootstrap-production-admin.ts",
    "set:production-admin-password": "tsx scripts/set-production-admin-password.ts",
    "verify:production-governance": "tsx scripts/verify-production-governance.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@vinext/cloudflare": "1.0.0-beta.4",
    "lucide-react": "0.468.0",
    "pdfmake": "^0.3.11",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "8.20.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "dotenv": "17.4.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prisma": "7.9.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.4",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
