model EventRegistration {
  id                 String            @id
  eventId            String            @map("event_id")
  participantType    String            @default("MEMBER") @map("participant_type")
  personId           String?           @map("person_id")
  fullName           String            @map("full_name")
  email              String?
  phone              String?
  organization       String?
  regionName         String?           @map("region_name")
  guestGroup         String?           @map("guest_group")
  registrationStatus String            @default("REGISTERED") @map("registration_status")
  registrationSource String            @default("SELF") @map("registration_source")
  registeredBy       String?           @map("registered_by")
  registeredAt       DateTime          @default(now()) @map("registered_at")
  cancelledBy        String?           @map("cancelled_by")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  seatingUnitId      String?           @map("seating_unit_id")
  seatNumber         Int?              @map("seat_number")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person             PersonProfile?    @relation(fields: [personId], references: [id], onDelete: Restrict)
  creator            User?             @relation("EventRegistrationCreator", fields: [registeredBy], references: [id], onDelete: SetNull)
