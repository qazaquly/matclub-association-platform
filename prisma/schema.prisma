  responsibleDepartment   Department?         @relation("EventResponsibleDepartment", fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  creator                 User                @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Restrict)
