  projectScope            String               @map("project_scope")
  branchId                String?              @map("branch_id")
  responsibleDepartmentId String?              @map("responsible_department_id")
  leaderProfileId         String?              @map("leader_profile_id")
  startDate               DateTime             @map("start_date") @db.Date
  endDate                 DateTime?            @map("end_date") @db.Date
  status                  String               @default("DRAFT")
  statusNote              String?              @map("status_note")
  publicProjectId         String?              @unique @map("public_project_id")
  createdBy               String               @map("created_by")
  updatedBy               String               @map("updated_by")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  archivedAt              DateTime?            @map("archived_at")
  branch                  Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  responsibleDepartment   Department?          @relation("ProjectResponsibleDepartment", fields: [responsibleDepartmentId], references: [id], onDelete: Restrict)
  leaderProfile           PersonProfile?       @relation("ProjectLeader", fields: [leaderProfileId], references: [id], onDelete: SetNull)
  publicProject           PublicProject?       @relation(fields: [publicProjectId], references: [id], onDelete: SetNull)
  creator                 User                 @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
