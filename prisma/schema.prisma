  @@unique([eventId, seatingUnitId, seatNumber], map: "event_registrations_event_seat_unique")
  @@index([eventId, registrationStatus, registeredAt], map: "event_registrations_event_status_idx")
  @@index([personId, registeredAt], map: "event_registrations_person_idx")
  @@map("event_registrations")
}

model EventAttendance {
